<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root_view"
  style="@style/root_view"
  >
  <TextView android:id="@+id/title"
    style="@style/text_title"
  />
  <LinearLayout
    style="@style/base_padding"
    android:layout_width="match_parent" 
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_below="@id/title"
    >

    <TextView android:id="@+id/silexgis_reason" 
        android:layout_marginTop="@dimen/margintiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
        android:textColor="@color/textdelete"
        android:visibility="gone"
      />

    <TextView
        android:layout_marginTop="@dimen/margintiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
        android:text="@string/silexgis_pref_url_title"
      />
    <EditText android:id="@+id/silexgis_url" 
      style="@style/edit_text"
        android:layout_marginTop="@dimen/margintiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
        android:inputType="textUri"
        android:hint="@string/silexgis_url_hint"
        android:importantForAutofill="no"
      />

    <TextView
        android:layout_marginTop="@dimen/margintiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
        android:text="@string/silexgis_pref_key_title"
      />
    <EditText android:id="@+id/silexgis_key" 
      style="@style/edit_text"
        android:layout_marginTop="@dimen/margintiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
        android:inputType="textPassword"
        android:hint="@string/silexgis_key_hint"
        android:importantForAutofill="no"
      />

    <TextView android:id="@+id/silexgis_result" 
        android:layout_marginTop="@dimen/marginv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" 
      />

    <LinearLayout android:id="@+id/help"
      style="@style/help_layout"
      >
      <Button android:id="@+id/button_help"
          style="@style/button_empty"
          android:text="@string/button_help"
        android:layout_marginRight="@dimen/marginh"
      />
        <Button android:id="@+id/button_cancel"
          style="@style/button_default"
          android:text="@string/button_cancel"
        />
      <LinearLayout
        android:layout_width="fill_parent" 
        android:layout_height="wrap_content"
        android:gravity="end"
        >
        <Button android:id="@+id/button_forget"
          style="@style/button_default"
          android:text="@string/button_forget"
          android:layout_marginEnd="@dimen/marginh"
        />
        <Button android:id="@+id/button_test"
          style="@style/button_default"
          android:text="@string/silexgis_button_test"
          android:layout_marginEnd="@dimen/marginh"
        />
        <Button android:id="@+id/button_ok"
          style="@style/button_default"
          android:text="@string/button_ok"
        />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>

</RelativeLayout>
