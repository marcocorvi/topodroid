<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root_view"
  style="@style/root_view"
  >
  <TextView android:id="@+id/title"
    style="@style/text_title"
  />
  <LinearLayout
    style="@style/base_padding"
    android:layout_width="match_parent" 
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_below="@id/title"
    >

    <TextView android:id="@+id/silexgis_step"
      android:layout_width="match_parent" 
      android:layout_height="wrap_content" 
      android:layout_marginTop="@dimen/marginv"
      />
    <ProgressBar android:id="@+id/silexgis_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="20dp" 
      android:layout_marginTop="@dimen/marginv"
      android:indeterminate="false"
      android:max="100"
      android:progress="0"
      />
    <TextView android:id="@+id/silexgis_detail"
      android:layout_width="match_parent" 
      android:layout_height="wrap_content" 
      android:layout_marginTop="@dimen/marginv"
      />

    <LinearLayout android:id="@+id/help"
      style="@style/help_layout"
      >
      <LinearLayout
        android:layout_width="fill_parent" 
        android:layout_height="wrap_content"
        android:gravity="end"
        >
        <Button android:id="@+id/button_cancel"
          style="@style/button_default"
          android:text="@string/button_cancel"
        />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>

</RelativeLayout>
