<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/root_view"
  style="@style/root_view"
  >
  <TextView android:id="@+id/title"
    style="@style/text_title"
  />
  <LinearLayout
    style="@style/base_padding"
    android:layout_width="match_parent" 
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_below="@id/title"
    >

    <Button android:id="@+id/silexgis_auto"
      style="@style/button_default"
      android:layout_width="match_parent" 
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margintiny"
      android:text="@string/silexgis_target_auto"
      />
    <Button android:id="@+id/silexgis_last"
      style="@style/button_default"
      android:layout_width="match_parent" 
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/margintiny"
      android:visibility="gone"
      />

    <EditText android:id="@+id/silexgis_search" 
      style="@style/edit_text"
      android:layout_marginTop="@dimen/marginv"
      android:layout_width="match_parent"
      android:inputType="text"
      android:hint="@string/silexgis_cave_search"
      android:importantForAutofill="no"
      />
    <TextView android:id="@+id/silexgis_search_result" 
      android:layout_width="match_parent"
      android:layout_height="wrap_content" 
      />
    <ListView android:id="@+id/silexgis_caves"
      android:layout_width="match_parent"
      android:layout_height="160dp"
      />

    <TextView
      android:layout_marginTop="@dimen/marginv"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" 
      android:text="@string/silexgis_cave_new"
      />
    <EditText android:id="@+id/silexgis_new_name" 
      style="@style/edit_text"
      android:layout_width="match_parent"
      android:inputType="text"
      android:importantForAutofill="no"
      />
    <Spinner android:id="@+id/silexgis_new_visibility"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:drawSelectorOnTop="true"
      />
    <CheckBox android:id="@+id/silexgis_new_protected"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/silexgis_protect_location"
      />
    <TextView android:id="@+id/silexgis_no_creation" 
      android:layout_width="match_parent"
      android:layout_height="wrap_content" 
      android:textColor="@color/textdelete"
      android:text="@string/silexgis_cave_no_creation"
      android:visibility="gone"
      />

    <LinearLayout android:id="@+id/help"
      style="@style/help_layout"
      >
      <Button android:id="@+id/button_help"
        style="@style/button_empty"
        android:text="@string/button_help"
        android:layout_marginEnd="@dimen/marginh"
      />
      <Button android:id="@+id/button_cancel"
        style="@style/button_default"
        android:text="@string/button_cancel"
      />
      <LinearLayout
        android:layout_width="fill_parent" 
        android:layout_height="wrap_content"
        android:gravity="end"
        >
        <Button android:id="@+id/button_ok"
          style="@style/button_default"
          android:text="@string/silexgis_cave_new"
        />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>

</RelativeLayout>
